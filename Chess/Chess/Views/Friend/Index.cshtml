@{
    Layout = null;

    var friends = ViewBag.Friends as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
    var incomingRequests = ViewBag.IncomingRequests as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
    var outgoingRequests = ViewBag.OutgoingRequests as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
    var schedules = ViewBag.Schedules as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();

    int currentUserId = ViewBag.CurrentUserId == null ? 0 : Convert.ToInt32(ViewBag.CurrentUserId);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Bạn bè - Chess Online</title>

    <link rel="stylesheet" href="~/css/TrangChinh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Friend.css" asp-append-version="true" />
</head>

<body>
    <div class="gradient-bg"></div>
    <div class="stars"></div>

    <nav class="navbar">
        <div class="nav-container">
            <a class="logo-modern nav-logo-link" asp-controller="Home" asp-action="Index">
                <img src="/IMG/Logo/LogoTrangChinh.png" alt="Logo Quyến" class="main-logo-img">
                <span>Chess Online</span>
            </a>

            <ul class="nav-menu">
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li><a asp-controller="Play" asp-action="Index">Chơi cờ</a></li>
                <li><a asp-controller="Friend" asp-action="Index">Bạn bè</a></li>
                <li><a asp-controller="Play" asp-action="Ranking">Xếp hạng</a></li>
            </ul>
        </div>
    </nav>

    <main class="friend-page">
        <section class="friend-hero">
            <div>
                <p class="friend-subtitle">Kết nối người chơi</p>
                <h1>Bạn bè & hẹn phòng</h1>
                <p>
                    Tìm kiếm người chơi, gửi lời mời kết bạn, xem danh sách bạn bè và hẹn phòng chơi cờ.
                </p>
            </div>

            <a class="friend-search-btn" asp-controller="Friend" asp-action="Search">
                🔍 Tìm kiếm bạn
            </a>
        </section>

        @if (TempData["Success"] != null)
        {
            <div class="friend-alert success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="friend-alert error">
                @TempData["Error"]
            </div>
        }

        <section class="friend-grid">
            <div class="friend-card">
                <div class="friend-card-header">
                    <h2>Lời mời kết bạn</h2>
                    <span>@incomingRequests.Count lời mời</span>
                </div>

                @if (incomingRequests.Count == 0)
                {
                    <div class="friend-empty">
                        Hiện chưa có lời mời kết bạn nào.
                    </div>
                }
                else
                {
                    <div class="friend-list">
                        @foreach (var item in incomingRequests)
                        {
                            var userId = Convert.ToInt32(item["UserID"]);
                            var avatar = item["Avatar"]?.ToString();
                            var tenDangNhap = item["TenDangNhap"]?.ToString();
                            var hoTen = item["HoTen"]?.ToString();
                            var diem = item["Diem"]?.ToString();
                            var loiMoiId = Convert.ToInt32(item["LoiMoiID"]);

                            <div class="friend-item">
                                <div class="friend-user">
                                    <div class="friend-avatar">
                                        @if (!string.IsNullOrWhiteSpace(avatar))
                                        {
                                            <img src="@avatar" alt="@tenDangNhap" />
                                        }
                                        else
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(tenDangNhap) ? "U" : tenDangNhap.Substring(0, 1).ToUpper())</span>
                                        }
                                    </div>

                                    <div>
                                        <h3>@tenDangNhap</h3>
                                        <p>@(string.IsNullOrWhiteSpace(hoTen) ? "Người chơi Chess Online" : hoTen)</p>
                                        <small>Điểm: @diem</small>
                                    </div>
                                </div>

                                <div class="friend-actions">
                                    <form asp-controller="Friend" asp-action="AcceptRequest" method="post">
                                        <input type="hidden" name="requestId" value="@loiMoiId" />
                                        <button type="submit" class="btn-accept">Chấp nhận</button>
                                    </form>

                                    <form asp-controller="Friend" asp-action="RejectRequest" method="post">
                                        <input type="hidden" name="requestId" value="@loiMoiId" />
                                        <button type="submit" class="btn-reject">Từ chối</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="friend-card">
                <div class="friend-card-header">
                    <h2>Lời mời đã gửi</h2>
                    <span>@outgoingRequests.Count đang chờ</span>
                </div>

                @if (outgoingRequests.Count == 0)
                {
                    <div class="friend-empty">
                        Bạn chưa gửi lời mời nào.
                    </div>
                }
                else
                {
                    <div class="friend-list">
                        @foreach (var item in outgoingRequests)
                        {
                            var avatar = item["Avatar"]?.ToString();
                            var tenDangNhap = item["TenDangNhap"]?.ToString();
                            var hoTen = item["HoTen"]?.ToString();
                            var diem = item["Diem"]?.ToString();
                            var loiMoiId = Convert.ToInt32(item["LoiMoiID"]);

                            <div class="friend-item">
                                <div class="friend-user">
                                    <div class="friend-avatar">
                                        @if (!string.IsNullOrWhiteSpace(avatar))
                                        {
                                            <img src="@avatar" alt="@tenDangNhap" />
                                        }
                                        else
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(tenDangNhap) ? "U" : tenDangNhap.Substring(0, 1).ToUpper())</span>
                                        }
                                    </div>

                                    <div>
                                        <h3>@tenDangNhap</h3>
                                        <p>@(string.IsNullOrWhiteSpace(hoTen) ? "Người chơi Chess Online" : hoTen)</p>
                                        <small>Điểm: @diem</small>
                                    </div>
                                </div>

                                <div class="friend-actions">
                                    <form asp-controller="Friend" asp-action="CancelRequest" method="post">
                                        <input type="hidden" name="requestId" value="@loiMoiId" />
                                        <button type="submit" class="btn-cancel">Hủy lời mời</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="friend-card full">
            <div class="friend-card-header">
                <h2>Danh sách bạn bè</h2>
                <span>@friends.Count bạn bè</span>
            </div>

            @if (friends.Count == 0)
            {
                <div class="friend-empty large">
                    Bạn chưa có bạn bè nào. Hãy tìm kiếm người chơi và gửi lời mời kết bạn.
                    <br />
                    <a asp-controller="Friend" asp-action="Search">Tìm bạn ngay</a>
                </div>
            }
            else
            {
                <div class="friend-list grid-list">
                    @foreach (var item in friends)
                    {
                        var friendId = Convert.ToInt32(item["UserID"]);
                        var avatar = item["Avatar"]?.ToString();
                        var tenDangNhap = item["TenDangNhap"]?.ToString();
                        var hoTen = item["HoTen"]?.ToString();
                        var diem = item["Diem"]?.ToString();

                        <div class="friend-item friend-box">
                            <div class="friend-user">
                                <div class="friend-avatar big">
                                    @if (!string.IsNullOrWhiteSpace(avatar))
                                    {
                                        <img src="@avatar" alt="@tenDangNhap" />
                                    }
                                    else
                                    {
                                        <span>@(string.IsNullOrWhiteSpace(tenDangNhap) ? "U" : tenDangNhap.Substring(0, 1).ToUpper())</span>
                                    }
                                </div>

                                <div>
                                    <h3>@tenDangNhap</h3>
                                    <p>@(string.IsNullOrWhiteSpace(hoTen) ? "Người chơi Chess Online" : hoTen)</p>
                                    <small>Điểm cao nhất: @diem</small>
                                </div>
                            </div>

                            <div class="friend-actions friend-actions-row">
                                <a class="btn-schedule" asp-controller="Friend" asp-action="Schedule" asp-route-friendId="@friendId">
                                    Hẹn phòng
                                </a>

                                <form asp-controller="Friend" asp-action="RemoveFriend" method="post"
                                      onsubmit="return confirm('Bạn có chắc muốn hủy kết bạn không?');">
                                    <input type="hidden" name="friendId" value="@friendId" />
                                    <button type="submit" class="btn-remove">Hủy bạn</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="friend-card full">
            <div class="friend-card-header">
                <h2>Lịch hẹn phòng</h2>
                <span>@schedules.Count lịch hẹn</span>
            </div>

            @if (schedules.Count == 0)
            {
                <div class="friend-empty">
                    Chưa có lịch hẹn phòng nào.
                </div>
            }
            else
            {
                <div class="schedule-list">
                    @foreach (var item in schedules)
                    {
                        var scheduleId = Convert.ToInt32(item["LichHenID"]);
                        var nguoiTaoId = Convert.ToInt32(item["NguoiTaoID"]);
                        var nguoiDuocMoiId = Convert.ToInt32(item["NguoiDuocMoiID"]);
                        var trangThai = item["TrangThai"]?.ToString();
                        var tenCheDo = item["TenCheDo"]?.ToString();
                        var loaiCheDo = item["LoaiCheDo"]?.ToString();
                        var ghiChu = item["GhiChu"]?.ToString();
                        var thoiGianHen = item["ThoiGianHen"] == null || item["ThoiGianHen"].ToString() == ""
                        ? ""
                        : Convert.ToDateTime(item["ThoiGianHen"]).ToString("dd/MM/yyyy HH:mm");

                        var tenNguoiTao = item["TenNguoiTao"]?.ToString();
                        var tenNguoiDuocMoi = item["TenNguoiDuocMoi"]?.ToString();

                        bool isReceiver = nguoiDuocMoiId == currentUserId;
                        bool canRespond = isReceiver && trangThai == "PENDING";
                        bool canCreateRoom = trangThai == "ACCEPTED";
                        bool hasRoom = item["PhongID"] != null && item["PhongID"].ToString() != "";

                        <div class="schedule-item">
                            <div class="schedule-main">
                                <h3>
                                    @tenNguoiTao hẹn @tenNguoiDuocMoi
                                </h3>

                                <p>
                                    Chế độ: <b>@tenCheDo</b> - @loaiCheDo
                                </p>

                                <p>
                                    Thời gian: <b>@thoiGianHen</b>
                                </p>

                                @if (!string.IsNullOrWhiteSpace(ghiChu))
                                {
                                    <p>Ghi chú: @ghiChu</p>
                                }

                                <span class="schedule-status @trangThai?.ToLower()">
                                    @trangThai
                                </span>
                            </div>

                            <div class="schedule-actions">
                                @if (canRespond)
                                {
                                    <form asp-controller="Friend" asp-action="AcceptSchedule" method="post">
                                        <input type="hidden" name="scheduleId" value="@scheduleId" />
                                        <button type="submit" class="btn-accept">Chấp nhận</button>
                                    </form>

                                    <form asp-controller="Friend" asp-action="RejectSchedule" method="post">
                                        <input type="hidden" name="scheduleId" value="@scheduleId" />
                                        <button type="submit" class="btn-reject">Từ chối</button>
                                    </form>
                                }

                                @if (canCreateRoom && !hasRoom)
                                {
                                    <form asp-controller="Friend" asp-action="CreateRoomFromSchedule" method="post">
                                        <input type="hidden" name="scheduleId" value="@scheduleId" />
                                        <button type="submit" class="btn-room">Tạo phòng</button>
                                    </form>
                                }

                                @if (hasRoom)
                                {
                                    <a class="btn-room" asp-controller="Play" asp-action="Room" asp-route-id="@item["PhongID"]">
                                        Vào phòng
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </main>
</body>
<!-- FOOTER DÙNG CHUNG CHO CÁC TRANG -->
<footer class="footer-modern">
    <div class="footer-grid">

        <div class="footer-col">
            <h4>Sản Phẩm</h4>
            <ul>
                <li>
                    <a asp-controller="Play" asp-action="Online">
                        Chơi Trực Tiếp
                    </a>
                </li>

                <li>
                    <a asp-controller="Play" asp-action="Analysis">
                        Phân Tích
                    </a>
                </li>

                <li>
                    <a asp-controller="Play" asp-action="HocCoBan">
                        Học Tập
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Công Ty</h4>
            <ul>
                <li>
                    <a href="#" class="js-open-about-modal">
                        Về Chúng Tôi
                    </a>
                </li>

                <li>
                    <a href="#" class="js-open-blog-modal">
                        Blog
                    </a>
                </li>

                <li>
                    <a href="#" class="js-open-contact-modal">
