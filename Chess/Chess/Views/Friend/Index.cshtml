        </div>

        <div class="footer-col">
            <h4>Pháp Lý</h4>
            <ul>
                <li>
                    <a href="#" class="js-open-terms-modal">
                        Điều Khoản
                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="Privacy">
                        Privacy
                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="Cookies">
                        Cookies
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Mạng Xã Hội</h4>

            <div class="social-links">
                <a href="https://www.facebook.com/"
                   target="_blank"
                   rel="noopener noreferrer"
