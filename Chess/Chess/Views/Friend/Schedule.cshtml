@{
    Layout = null;

    var friend = ViewBag.Friend as Dictionary<string, object> ?? new Dictionary<string, object>();
    var modes = ViewBag.Modes as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();

    int friendId = ViewBag.FriendId == null ? 0 : Convert.ToInt32(ViewBag.FriendId);

    string tenDangNhap = friend.ContainsKey("TenDangNhap") ? friend["TenDangNhap"]?.ToString() ?? "" : "";
    string hoTen = friend.ContainsKey("HoTen") ? friend["HoTen"]?.ToString() ?? "" : "";
    string avatar = friend.ContainsKey("Avatar") ? friend["Avatar"]?.ToString() ?? "" : "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hẹn phòng - Chess Online</title>

    <link rel="stylesheet" href="~/css/TrangChinh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Friend.css" asp-append-version="true" />
</head>

<body>
    <div class="gradient-bg"></div>
    <div class="stars"></div>

    <nav class="navbar">
        <div class="nav-container">
            <a class="logo-modern nav-logo-link" asp-controller="Home" asp-action="Index">
                <img src="/IMG/Logo/LogoTrangChinh.png" alt="Logo Quyến" class="main-logo-img">
                <span>Chess Online</span>
            </a>

            <ul class="nav-menu">
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li><a asp-controller="Play" asp-action="Index">Chơi cờ</a></li>
                <li><a asp-controller="Friend" asp-action="Index">Bạn bè</a></li>
                <li><a asp-controller="Play" asp-action="Ranking">Xếp hạng</a></li>
            </ul>
        </div>
    </nav>

    <main class="friend-page">
        <section class="friend-hero">
            <div>
                <p class="friend-subtitle">Lên lịch chơi cờ</p>
                <h1>Hẹn phòng với bạn bè</h1>
                <p>
                    Chọn chế độ chơi, thời gian hẹn và gửi lời mời hẹn phòng cho bạn của bạn.
                </p>
            </div>

            <a class="friend-search-btn" asp-controller="Friend" asp-action="Index">
                ← Quay lại bạn bè
            </a>
        </section>

        @if (TempData["Success"] != null)
        {
            <div class="friend-alert success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="friend-alert error">
                @TempData["Error"]
            </div>
        }

        <section class="schedule-create-layout">
            <div class="friend-card">
                <div class="friend-card-header">
                    <h2>Người được hẹn</h2>
                    <span>Bạn bè</span>
                </div>

                <div class="friend-item friend-box">
                    <div class="friend-user">
                        <div class="friend-avatar big">
                            @if (!string.IsNullOrWhiteSpace(avatar))
                            {
                                <img src="@avatar" alt="@tenDangNhap" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(tenDangNhap) ? "U" : tenDangNhap.Substring(0, 1).ToUpper())</span>
                            }
                        </div>

                        <div>
                            <h3>@tenDangNhap</h3>
                            <p>@(string.IsNullOrWhiteSpace(hoTen) ? "Người chơi Chess Online" : hoTen)</p>
                            <small>Sẵn sàng hẹn phòng</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="friend-card">
                <div class="friend-card-header">
                    <h2>Thông tin lịch hẹn</h2>
                    <span>Form hẹn</span>
                </div>

                <form class="schedule-form" asp-controller="Friend" asp-action="Schedule" method="post">
                    <input type="hidden" name="friendId" value="@friendId" />

                    <div class="schedule-form-group">
                        <label>Chế độ chơi</label>

                        <select name="cheDoId" required>
                            @foreach (var mode in modes)
                            {
                                var cheDoId = mode["CheDoID"]?.ToString();
                                var tenCheDo = mode["TenCheDo"]?.ToString();
                                var loaiCheDo = mode["LoaiCheDo"]?.ToString();
                                var thoiGian = mode["ThoiGian"]?.ToString();

                                <option value="@cheDoId">
                                    @tenCheDo - @loaiCheDo - @thoiGian giây
                                </option>
                            }
                        </select>
                    </div>

                    <div class="schedule-form-group">
                        <label>Thời gian hẹn</label>

                        <input type="datetime-local"
                               name="thoiGianHen"
                               required />
                    </div>

                    <div class="schedule-form-group">
                        <label>Ghi chú</label>

                        <textarea name="ghiChu"
                                  rows="4"
                                  placeholder="Ví dụ: 20h tối nay chơi cờ nhanh nha..."></textarea>
                    </div>

                    <button type="submit" class="schedule-submit-btn">
                        Gửi lịch hẹn
                    </button>
                </form>
            </div>
        </section>
    </main>
</body>
</html>
