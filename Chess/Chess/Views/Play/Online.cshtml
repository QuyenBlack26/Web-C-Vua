@{
    ViewData["Title"] = "PvP Online";
    var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "Người chơi";
}
@{
    Layout = null;
}

<!-- FILE CSS PVP ONLINE -->
<link rel="stylesheet" href="~/css/PvPOnline.css" />

<link rel="stylesheet" href="~/css/TrangChinh.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/ChessSkin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/KichThuoc.css" asp-append-version="true" />


@using Microsoft.AspNetCore.Http

<!-- THANH ĐIỀU HƯỚNG DÙNG CHUNG -->
<nav class="navbar">
    <div class="nav-container">

        <!-- LOGO WEBSITE -->
        <a asp-controller="Home"
           asp-action="Index"
           class="logo-modern nav-logo-link">
            <img src="/IMG/Logo/LogoTrangChinh.png" alt="Logo Quyến" class="main-logo-img">
            <span>Chess Online</span>
        </a>

        <!-- MENU TRANG CHÍNH -->
        <ul class="nav-menu">
            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="home">
                    Trang Chủ
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="features">
                    Tính Năng
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="play">
                    Chơi Ngay
                </a>
            </li>

            <li><a asp-controller="Friend" asp-action="Index">Bạn bè</a></li>

            @if (Context.Session.GetString("TenDangNhap") != null)
            {
                var avatar = Context.Session.GetString("Avatar");
                var hoTen = Context.Session.GetString("HoTen");
                var tenHienThi = string.IsNullOrWhiteSpace(hoTen) ? tenDangNhap : hoTen;
                var chuCai = tenHienThi.Length > 0 ? tenHienThi.Substring(0, 1).ToUpper() : "U";

                <li class="user-menu">
                    <details class="user-dropdown">

                        <!-- AVATAR USER -->
                        <summary class="avatar-btn">
                            <div class="avatar-circle">
                                @if (!string.IsNullOrWhiteSpace(avatar))
                                {
                                    <img src="@avatar"
                                         alt="Avatar"
                                         class="avatar-img" />
                                }
                                else
                                {
                                    @chuCai
                                }
                            </div>
                        </summary>

                        <!-- DROPDOWN THÔNG TIN USER -->
                        <div class="user-card">
                            <div class="user-card-header">
                                <div class="user-avatar-lg">
                                    @if (!string.IsNullOrWhiteSpace(avatar))
                                    {
                                        <img src="@avatar"
                                             alt="Avatar"
                                             class="user-avatar-img" />
                                    }
                                    else
                                    {
                                        @chuCai
                                    }
                                </div>

                                <div>
                                    <p class="user-card-name">@tenHienThi</p>
                                    <p class="user-card-role">Người chơi</p>
                                </div>
                            </div>

                            <a asp-controller="Home"
                               asp-action="ThongTinCaNhan"
                               class="btn-detail">
                                👤 Xem chi tiết
                            </a>

                            <a asp-controller="Home"
                               asp-action="DangXuat"
                               class="btn-logout">
                                🚪 Đăng xuất
                            </a>
                        </div>

                    </details>
                </li>
            }
            else
            {
                <li>
                    <a asp-controller="Home"
                       asp-action="DangNhap"
                       class="btn-nav-login">
                        Đăng Nhập
                    </a>
                </li>
            }
        </ul>

        <!-- NÚT MENU MOBILE -->
        <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

    </div>
</nav>

<!-- TRANG PVP ONLINE -->
<div class="pvp-online-page">

    <!-- PHẦN TIÊU ĐỀ PVP ONLINE -->
    <div class="pvp-online-header">
        <div>
            <h1>PvP Online</h1>
            <p>Chọn quân, chọn thời gian và ghép trận với người chơi khác.</p>
        </div>

        <a asp-controller="Play" asp-action="Index" class="btn-back">Quay lại</a>
    </div>

    <!-- BỐ CỤC GHÉP TRẬN -->
    <div class="pvp-online-layout">

        <!-- THẺ THIẾT LẬP TÌM TRẬN -->
        <section class="match-card setup-card" id="setupCard">

            <!-- THÔNG TIN NGƯỜI CHƠI -->
            <div class="player-info">
                <div class="player-avatar">
                    @tenDangNhap.Substring(0, 1).ToUpper()
                </div>

                <div>
                    <h2>@tenDangNhap</h2>
                    <p>Đang chuẩn bị tìm trận</p>
                </div>
            </div>

            <!-- CHỌN MÀU QUÂN -->
            <div class="option-group">
                <h3>Chọn màu quân</h3>

                <div class="choice-grid" id="colorChoices">
                    <button type="button" class="choice active" data-color="white">
                        <span>♔</span>
                        Trắng
                    </button>

                    <button type="button" class="choice" data-color="black">
                        <span>♚</span>
                        Đen
                    </button>

                    <button type="button" class="choice" data-color="random">
                        <span>🎲</span>
                        Ngẫu nhiên
                    </button>
                </div>
            </div>

            <!-- CHỌN THỜI GIAN -->
            <div class="option-group">
                <h3>Chọn thời gian</h3>

                <div class="choice-grid time-grid" id="timeChoices">
                    <button type="button" class="choice active" data-time="3">
                        30 phút
                    </button>

                    <button type="button" class="choice" data-time="5">
                        45 phút
                    </button>

                    <button type="button" class="choice" data-time="10">
                        50 phút
                    </button>

                    <button type="button" class="choice" data-time="15">
                        60 phút
                    </button>
                </div>
            </div>

            <!-- NÚT TÌM TRẬN -->
            <button type="button" class="btn-find" onclick="startMatchmaking()">
                Tìm trận PvP
            </button>
        </section>

        <!-- THẺ ĐANG TÌM ĐỐI THỦ -->
        <section class="match-card searching-card hidden" id="searchingCard">
            <div class="loader-ring"></div>

            <h2>Đang tìm đối thủ...</h2>
            <p id="searchText">Đang kết nối tới hàng chờ PvP online</p>

            <!-- THÔNG TIN ĐANG GHÉP TRẬN -->
            <div class="match-detail">
                <div>
                    <span>Màu quân</span>
                    <strong id="selectedColorText">Trắng</strong>
                </div>

                <div>
                    <span>Thời gian</span>
                    <strong id="selectedTimeText">3 phút</strong>
                </div>

                <div>
                    <span>Trạng thái</span>
                    <strong id="matchStatusText">Đang ghép trận</strong>
                </div>
            </div>

            <!-- NÚT HỦY TÌM TRẬN -->
            <button type="button" class="btn-cancel" onclick="cancelMatchmaking()">
                Hủy tìm trận
            </button>
        </section>

        <!-- THẺ ĐÃ TÌM THẤY ĐỐI THỦ -->
        <section class="match-card found-card hidden" id="foundCard">

            <!-- KHUNG HIỂN THỊ HAI NGƯỜI CHƠI -->
            <div class="versus-box">
                <div class="versus-player">
                    <div class="versus-avatar">@tenDangNhap.Substring(0, 1).ToUpper()</div>
                    <h3>@tenDangNhap</h3>
                    <p id="myColorText">Trắng</p>
                </div>

                <div class="vs-text">VS</div>

                <div class="versus-player">
                    <div class="versus-avatar opponent">?</div>
                    <h3 id="opponentName">Đối thủ</h3>
                    <p id="opponentColorText">Đen</p>
                </div>
            </div>

            <!-- THÔNG TIN PHÒNG ĐẤU -->
            <div class="room-info">
                <p>Mã phòng: <strong id="roomCode">---</strong></p>
                <p>Thời gian: <strong id="roomTime">3 phút</strong></p>
                <p>Trạng thái: <strong>Đã ghép trận</strong></p>
            </div>

            <!-- NÚT VÀO PHÒNG HOẶC TÌM TRẬN KHÁC -->
            <div class="found-actions">
                <button type="button" class="btn-enter" onclick="enterRoom()">
                    Vào bàn cờ
                </button>

                <button type="button" class="btn-cancel" onclick="resetMatchmaking()">
                    Tìm trận khác
                </button>
            </div>
        </section>
    </div>
</div>

<!-- FOOTER DÙNG CHUNG CHO CÁC TRANG -->
<footer class="footer-modern">
    <div class="footer-grid">

        <div class="footer-col">
            <h4>Sản Phẩm</h4>
            <ul>
                <li>
                    <a asp-controller="Play" asp-action="Online">
                        Chơi Trực Tiếp
                    </a>
                </li>

                <li>
                    <a asp-controller="Play" asp-action="Analysis">
                        Phân Tích
                    </a>
                </li>

                <li>
                    <a asp-controller="Play" asp-action="HocCoBan">
                        Học Tập
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Công Ty</h4>
            <ul>
                <li>
                    <a href="#" class="js-open-about-modal">
                        Về Chúng Tôi
                    </a>
                </li>

                <li>
                    <a href="#" class="js-open-blog-modal">
                        Blog
                    </a>
                </li>

                <li>
                    <a href="#" class="js-open-contact-modal">
                        Liên Hệ
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Pháp Lý</h4>
            <ul>
                <li>
                    <a href="#" class="js-open-terms-modal">
                        Điều Khoản
                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="Privacy">
