                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="Cookies">
                        Cookies
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Mạng Xã Hội</h4>

            <div class="social-links">
                <a href="https://www.facebook.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Facebook">
                    f
                </a>

                <a href="https://x.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="X Twitter">
                    x
                </a>

                <a href="https://www.youtube.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="YouTube">
                    ▶
                </a>

                <a href="https://discord.com/"
