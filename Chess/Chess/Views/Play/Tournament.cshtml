        <!-- LOGO WEBSITE -->
        <a asp-controller="Home"
           asp-action="Index"
           class="logo-modern nav-logo-link">
            <img src="/IMG/Logo/LogoTrangChinh.png" alt="Logo Quyến" class="main-logo-img">
            <span>Chess Online</span>
        </a>

        <!-- MENU TRANG CHÍNH -->
        <ul class="nav-menu">
            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="home">
                    Trang Chủ
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="features">
                    Tính Năng
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="play">
                    Chơi Ngay
                </a>
            </li>

            <li><a asp-controller="Friend" asp-action="Index">Bạn bè</a></li>

            @if (Context.Session.GetString("TenDangNhap") != null)
            {
                var avatar = Context.Session.GetString("Avatar");
                var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "U";
                var hoTen = Context.Session.GetString("HoTen");
                var tenHienThi = string.IsNullOrWhiteSpace(hoTen) ? tenDangNhap : hoTen;
                var chuCai = tenHienThi.Length > 0 ? tenHienThi.Substring(0, 1).ToUpper() : "U";

                <li class="user-menu">
                    <details class="user-dropdown">

                        <!-- AVATAR USER -->
                        <summary class="avatar-btn">
                            <div class="avatar-circle">
                                @if (!string.IsNullOrWhiteSpace(avatar))
                                {
                                    <img src="@avatar"
                                         alt="Avatar"
                                         class="avatar-img" />
                                }
                                else
                                {
                                    @chuCai
                                }
                            </div>
                        </summary>

                        <!-- DROPDOWN THÔNG TIN USER -->
                        <div class="user-card">
                            <div class="user-card-header">
                                <div class="user-avatar-lg">
                                    @if (!string.IsNullOrWhiteSpace(avatar))
                                    {
                                        <img src="@avatar"
                                             alt="Avatar"
                                             class="user-avatar-img" />
                                    }
                                    else
                                    {
                                        @chuCai
                                    }
                                </div>

                                <div>
                                    <p class="user-card-name">@tenHienThi</p>
                                    <p class="user-card-role">Người chơi</p>
                                </div>
                            </div>

                            <a asp-controller="Home"
                               asp-action="ThongTinCaNhan"
                               class="btn-detail">
                                👤 Xem chi tiết
                            </a>

                            <a asp-controller="Home"
                               asp-action="DangXuat"
                               class="btn-logout">
                                🚪 Đăng xuất
                            </a>
                        </div>

                    </details>
                </li>
