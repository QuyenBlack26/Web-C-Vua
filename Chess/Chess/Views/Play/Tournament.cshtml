</nav>

<section class="tournament-page">

    <div class="tournament-hero">
        <span class="tournament-badge">Tournament</span>

        <h1>Giải Đấu Cờ Vua</h1>

        <p>
            Một giải đấu có 16 bảng, mỗi bảng gồm 2 người chơi.
            Người thắng từng bảng sẽ vào vòng trong cho đến khi tìm ra nhà vô địch.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="tournament-alert success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="tournament-alert error">
            @TempData["Error"]
        </div>
    }

    <div class="tournament-top-actions">
        <form asp-controller="Play" asp-action="TaoGiaiDau" method="post">
            <button type="submit" class="btn-create-tournament">
                + Tạo giải đấu mới
            </button>
        </form>

        <a asp-controller="Home" asp-action="Index" class="btn-back-home">
            ← Về trang chủ
        </a>
    </div>

    <div class="tournament-layout">

        <!-- CỘT TRÁI: DANH SÁCH GIẢI ĐẤU -->
        <aside class="tournament-list-card">
            <div class="tournament-card-header">
                <h2>Danh sách giải đấu</h2>
                <p>Chọn một giải đấu để xem chi tiết.</p>
            </div>

            @if (tournaments == null || tournaments.Count == 0)
            {
                <div class="tournament-empty">
                    Chưa có giải đấu nào.
                </div>
            }
            else
            {
                <div class="tournament-list">
                    @foreach (var item in tournaments)
                    {
                        int giaiDauId = Convert.ToInt32(item["GiaiDauID"]);
                        string activeClass = giaiDauId == currentGiaiDauId ? "active" : "";

                        string tenGiaiDau = item["TenGiaiDau"]?.ToString() ?? "";
                        string trangThai = item["TrangThai"]?.ToString() ?? "";
                        string tenVoDich = item["TenVoDich"]?.ToString() ?? "";
                        int soNguoiDangKy = Convert.ToInt32(item["SoNguoiDangKy"]);

                        <a asp-controller="Play"
                           asp-action="Tournament"
                           asp-route-giaiDauId="@giaiDauId"
                           class="tournament-list-item @activeClass">

                            <div>
                                <strong>@tenGiaiDau</strong>
                                <span>@soNguoiDangKy / 32 người</span>
                            </div>

                            <small class="status-badge @trangThai">
                                @trangThai
                            </small>

                            @if (!string.IsNullOrWhiteSpace(tenVoDich))
                            {
                                <p class="mini-champion">🏆 @tenVoDich</p>
                            }
                        </a>
                    }
                </div>
            }
        </aside>

        <!-- CỘT PHẢI: CHI TIẾT GIẢI ĐẤU -->
        <main class="tournament-detail-card">

            @if (selectedTournament == null)
            {
                <div class="tournament-empty big">
                    <h2>Chưa chọn giải đấu</h2>
                    <p>Hãy tạo giải đấu mới hoặc chọn một giải đấu ở danh sách bên trái.</p>
                </div>
            }
            else
            {
                string tenGiaiDau = selectedTournament["TenGiaiDau"]?.ToString() ?? "";
                string tenNguoiTao = selectedTournament["TenNguoiTao"]?.ToString() ?? "";
                string tenVoDich = selectedTournament["TenVoDich"]?.ToString() ?? "";

                <div class="tournament-detail-header">
                    <div>
                        <h2>@tenGiaiDau</h2>
                        <p>
                            Người tạo: <strong>@tenNguoiTao</strong>
                        </p>
                    </div>

                    <span class="status-badge large @selectedStatus">
                        @selectedStatus
                    </span>
                </div>

                <div class="tournament-summary-grid">
                    <div class="summary-box">
                        <span>Số người</span>
                        <strong>@playerCount / 32</strong>
                    </div>

                    <div class="summary-box">
                        <span>Số bảng</span>
                        <strong>16</strong>
                    </div>

                    <div class="summary-box">
                        <span>Thể thức</span>
                        <strong>Loại trực tiếp</strong>
                    </div>

                    <div class="summary-box champion">
                        <span>Vô địch</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(tenVoDich) ? "Chưa có" : tenVoDich)
                        </strong>
                    </div>
                </div>

                <div class="tournament-action-panel">

                    @if (selectedStatus == "CHO_DANG_KY")
                    {
                        if (!alreadyJoined && playerCount < 32)
                        {
                            <form asp-controller="Play" asp-action="ThamGiaGiaiDau" method="post">
                                <input type="hidden" name="giaiDauId" value="@currentGiaiDauId" />

                                <button type="submit" class="btn-join-tournament">
                                    Tham gia giải đấu
                                </button>
                            </form>
                        }
                        else if (alreadyJoined)
                        {
                            <button type="button" class="btn-disabled" disabled>
                                Bạn đã tham gia
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-disabled" disabled>
                                Giải đấu đã đủ người
                            </button>
                        }

                        if (isCreator)
                        {
                            <form asp-controller="Play" asp-action="BatDauGiaiDau" method="post">
                                <input type="hidden" name="giaiDauId" value="@currentGiaiDauId" />

                                @if (playerCount == 32)
                                {
                                    <button type="submit" class="btn-start-tournament">
                                        Bắt đầu giải đấu
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn-start-tournament" disabled>
                                        Cần đủ 32 người
                                    </button>
                                }
                            </form>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn-disabled" disabled>
                            Đăng ký đã đóng
                        </button>
                    }

                </div>

                <div class="tournament-section">
                    <h3>Người chơi tham gia</h3>

                    @if (players == null || players.Count == 0)
                    {
                        <div class="tournament-empty">
                            Chưa có người chơi nào tham gia.
                        </div>
                    }
                    else
                    {
                        <div class="player-grid">
                            @foreach (var player in players)
                            {
                                string avatar = player["Avatar"]?.ToString() ?? "/images/default-avatar.png";
                                string tenDangNhap = player["TenDangNhap"]?.ToString() ?? "";
                                string trangThaiNguoiChoi = player["TrangThai"]?.ToString() ?? "";
                                int soThuTu = Convert.ToInt32(player["SoThuTu"]);

                                <div class="player-card">
                                    <img src="@avatar" alt="Avatar" />

                                    <div>
                                        <strong>#@soThuTu - @tenDangNhap</strong>
                                        <span>@trangThaiNguoiChoi</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="tournament-section">
                    <h3>Sơ đồ trận đấu</h3>

                    @if (matches == null || matches.Count == 0)
                    {
                        <div class="tournament-empty">
                            Chưa có trận đấu. Khi đủ 32 người, người tạo có thể bấm bắt đầu giải đấu.
                        </div>
                    }
                    else
                    {
                        <div class="bracket-scroll">
                            <div class="bracket-layout">

                                @foreach (var round in roundConfigs)
                                {
                                    string roundTitle = round["Title"];
                                    string roundCode = round["Code"];

                                    var roundMatches = matches
                                    .Where(m => m["VongDau"]?.ToString() == roundCode)
                                    .OrderBy(m => Convert.ToInt32(m["ThuTuTran"]))
                                    .ToList();

                                    <div class="bracket-round">
                                        <h4>@roundTitle</h4>

                                        @if (roundMatches.Count == 0)
                                        {
                                            <div class="empty-round">
                                                Chưa có trận
                                            </div>
                                        }
                                        else
                                        {
                                            foreach (var match in roundMatches)
                                            {
                                                int tranId = Convert.ToInt32(match["TranDauGiaiDauID"]);

                                                int nguoiChoi1Id = match["NguoiChoi1ID"] == null || match["NguoiChoi1ID"].ToString() == ""
                                                ? 0
                                                : Convert.ToInt32(match["NguoiChoi1ID"]);

                                                int nguoiChoi2Id = match["NguoiChoi2ID"] == null || match["NguoiChoi2ID"].ToString() == ""
                                                ? 0
                                                : Convert.ToInt32(match["NguoiChoi2ID"]);

                                                int nguoiThangId = match["NguoiThangID"] == null || match["NguoiThangID"].ToString() == ""
                                                ? 0
                                                : Convert.ToInt32(match["NguoiThangID"]);

                                                string tenNguoiChoi1 = match["TenNguoiChoi1"]?.ToString() ?? "Đang chờ";
                                                string tenNguoiChoi2 = match["TenNguoiChoi2"]?.ToString() ?? "Đang chờ";
                                                string tenNguoiThang = match["TenNguoiThang"]?.ToString() ?? "";
                                                string trangThaiTran = match["TrangThai"]?.ToString() ?? "";
                                                string tenBang = match["TenBang"]?.ToString() ?? "";
                                                int thuTuTran = Convert.ToInt32(match["ThuTuTran"]);

                                                bool finished = nguoiThangId > 0;

                                                <div class="match-card">
                                                    <div class="match-head">
                                                        <span>
                                                            @(string.IsNullOrWhiteSpace(tenBang) ? $"Trận {thuTuTran}" : tenBang)
                                                        </span>

                                                        <small>@trangThaiTran</small>
                                                    </div>

                                                    <div class="match-player @(nguoiThangId == nguoiChoi1Id ? "winner" : "")">
                                                        <span>@tenNguoiChoi1</span>

                                                        @if (!finished && selectedStatus == "DANG_DIEN_RA" && nguoiChoi1Id > 0)
                                                        {
                                                            <form asp-controller="Play" asp-action="ChonNguoiThangGiaiDau" method="post">
                                                                <input type="hidden" name="tranDauGiaiDauId" value="@tranId" />
                                                                <input type="hidden" name="winnerId" value="@nguoiChoi1Id" />

                                                                <button type="submit">Thắng</button>
                                                            </form>
                                                        }
                                                        else if (nguoiThangId == nguoiChoi1Id)
                                                        {
                                                            <strong>Thắng</strong>
                                                        }
                                                    </div>

                                                    <div class="match-player @(nguoiThangId == nguoiChoi2Id ? "winner" : "")">
                                                        <span>@tenNguoiChoi2</span>

                                                        @if (!finished && selectedStatus == "DANG_DIEN_RA" && nguoiChoi2Id > 0)
                                                        {
                                                            <form asp-controller="Play" asp-action="ChonNguoiThangGiaiDau" method="post">
                                                                <input type="hidden" name="tranDauGiaiDauId" value="@tranId" />
                                                                <input type="hidden" name="winnerId" value="@nguoiChoi2Id" />

                                                                <button type="submit">Thắng</button>
                                                            </form>
                                                        }
                                                        else if (nguoiThangId == nguoiChoi2Id)
                                                        {
                                                            <strong>Thắng</strong>
                                                        }
                                                    </div>

                                                    @if (finished)
                                                    {
                                                        <div class="match-winner">
                                                            Người thắng: <b>@tenNguoiThang</b>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }

                            </div>
                        </div>
                    }
                </div>
            }

        </main>

    </div>

</section>

