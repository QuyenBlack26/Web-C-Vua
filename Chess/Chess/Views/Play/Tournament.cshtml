@{
    ViewData["Title"] = "Giải Đấu";

    var tournaments = ViewBag.Tournaments as List<Dictionary<string, object>>;
    var selectedTournament = ViewBag.SelectedTournament as Dictionary<string, object>;
    var players = ViewBag.Players as List<Dictionary<string, object>>;
    var matches = ViewBag.Matches as List<Dictionary<string, object>>;

    int currentUserId = ViewBag.CurrentUserId ?? 0;
    int currentGiaiDauId = ViewBag.CurrentGiaiDauId ?? 0;

    string selectedStatus = selectedTournament == null
        ? ""
        : selectedTournament["TrangThai"]?.ToString() ?? "";

    var roundConfigs = new List<Dictionary<string, string>>
    {
        new Dictionary<string, string> { { "Title", "Vòng bảng" }, { "Code", "VONG_BANG" } },
        new Dictionary<string, string> { { "Title", "Vòng 1/16" }, { "Code", "VONG_1_16" } },
        new Dictionary<string, string> { { "Title", "Tứ kết" }, { "Code", "TU_KET" } },
        new Dictionary<string, string> { { "Title", "Bán kết" }, { "Code", "BAN_KET" } },
        new Dictionary<string, string> { { "Title", "Chung kết" }, { "Code", "CHUNG_KET" } }
    };

    int? nguoiTaoId = null;

    if (selectedTournament != null &&
        selectedTournament.ContainsKey("NguoiTaoID") &&
        selectedTournament["NguoiTaoID"] != null &&
        selectedTournament["NguoiTaoID"].ToString() != "")
    {
        nguoiTaoId = Convert.ToInt32(selectedTournament["NguoiTaoID"]);
    }

    bool isCreator = nguoiTaoId.HasValue && nguoiTaoId.Value == currentUserId;

    bool alreadyJoined = false;

    if (players != null)
    {
        alreadyJoined = players.Any(p => Convert.ToInt32(p["UserID"]) == currentUserId);
    }

    int playerCount = players == null ? 0 : players.Count;
}

@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/Tournament.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/TrangChinh.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/KichThuoc.css" asp-append-version="true" />


@using Microsoft.AspNetCore.Http

<!-- THANH ĐIỀU HƯỚNG DÙNG CHUNG -->
