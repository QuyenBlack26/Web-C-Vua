@{
    ViewData["Title"] = "Học Từ Master";
}

@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/Master.css" />

<link rel="stylesheet" href="~/css/TrangChinh.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/KichThuoc.css" asp-append-version="true" />


@using Microsoft.AspNetCore.Http

<!-- THANH ĐIỀU HƯỚNG DÙNG CHUNG -->
<nav class="navbar">
    <div class="nav-container">

        <!-- LOGO WEBSITE -->
        <a asp-controller="Home"
           asp-action="Index"
           class="logo-modern nav-logo-link">
            <img src="/IMG/Logo/LogoTrangChinh.png" alt="Logo Quyến" class="main-logo-img">
            <span>Chess Online</span>
        </a>

        <!-- MENU TRANG CHÍNH -->
        <ul class="nav-menu">
            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="home">
                    Trang Chủ
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="features">
                    Tính Năng
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="play">
                    Chơi Ngay
                </a>
            </li>

            <li><a asp-controller="Friend" asp-action="Index">Bạn bè</a></li>

            @if (Context.Session.GetString("TenDangNhap") != null)
            {
                var avatar = Context.Session.GetString("Avatar");
                var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "U";
                var hoTen = Context.Session.GetString("HoTen");
                var tenHienThi = string.IsNullOrWhiteSpace(hoTen) ? tenDangNhap : hoTen;
                var chuCai = tenHienThi.Length > 0 ? tenHienThi.Substring(0, 1).ToUpper() : "U";

                <li class="user-menu">
                    <details class="user-dropdown">

                        <!-- AVATAR USER -->
                        <summary class="avatar-btn">
                            <div class="avatar-circle">
                                @if (!string.IsNullOrWhiteSpace(avatar))
                                {
                                    <img src="@avatar"
                                         alt="Avatar"
                                         class="avatar-img" />
                                }
                                else
                                {
                                    @chuCai
                                }
                            </div>
                        </summary>

                        <!-- DROPDOWN THÔNG TIN USER -->
                        <div class="user-card">
                            <div class="user-card-header">
                                <div class="user-avatar-lg">
                                    @if (!string.IsNullOrWhiteSpace(avatar))
                                    {
                                        <img src="@avatar"
                                             alt="Avatar"
                                             class="user-avatar-img" />
                                    }
                                    else
                                    {
                                        @chuCai
                                    }
                                </div>

                                <div>
                                    <p class="user-card-name">@tenHienThi</p>
                                    <p class="user-card-role">Người chơi</p>
                                </div>
                            </div>

                            <a asp-controller="Home"
                               asp-action="ThongTinCaNhan"
                               class="btn-detail">
                                👤 Xem chi tiết
                            </a>

                            <a asp-controller="Home"
                               asp-action="DangXuat"
                               class="btn-logout">
                                🚪 Đăng xuất
                            </a>
                        </div>

                    </details>
                </li>
            }
            else
            {
                <li>
                    <a asp-controller="Home"
                       asp-action="DangNhap"
                       class="btn-nav-login">
                        Đăng Nhập
                    </a>
                </li>
            }
        </ul>

        <!-- NÚT MENU MOBILE -->
        <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

    </div>
</nav>

<section class="master-page">
    <div class="master-hero">
        <span class="master-badge">Học cờ vua</span>
        <h1>Học Từ Master</h1>
        <p>
            Chọn nguồn học phù hợp với trình độ của bạn. Có cả video tiếng Việt
            và video nước ngoài để bạn học theo cách dễ hiểu nhất.
        </p>
    </div>

    <div class="master-filter">
        <button type="button" class="filter-btn active" data-filter="all">Tất cả</button>
        <button type="button" class="filter-btn" data-filter="basic">Cơ bản</button>
        <button type="button" class="filter-btn" data-filter="tactic">Chiến thuật</button>
        <button type="button" class="filter-btn" data-filter="opening">Khai cuộc</button>
        <button type="button" class="filter-btn" data-filter="endgame">Tàn cuộc</button>
        <button type="button" class="filter-btn" data-filter="vietnam">Tiếng Việt</button>
        <button type="button" class="filter-btn" data-filter="international">Quốc tế</button>
    </div>

    <div class="master-grid">

        <!-- CƠ BẢN - VIỆT NAM -->
        <a class="master-card" data-category="basic vietnam"
           href="https://www.youtube.com/results?search_query=học+cờ+vua+cơ+bản+cho+người+mới"
           target="_blank">
            <div class="master-icon">♙</div>

            <div class="master-content">
                <span class="master-level basic">Cơ bản - Tiếng Việt</span>
                <h2>Cờ Vua Cơ Bản</h2>
                <p>
                    Video tiếng Việt cho người mới học: cách đi quân, luật chiếu,
                    chiếu hết, nhập thành và phong cấp.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- CƠ BẢN - QUỐC TẾ -->
        <a class="master-card" data-category="basic international"
           href="https://www.youtube.com/results?search_query=chess+basics+for+beginners"
           target="_blank">
            <div class="master-icon">♙</div>

            <div class="master-content">
                <span class="master-level basic">Basic - Quốc tế</span>
                <h2>Chess Basics</h2>
                <p>
                    Video tiếng Anh cho người mới, phù hợp nếu bạn muốn học thêm
                    thuật ngữ cờ vua quốc tế.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- CHIẾN THUẬT - VIỆT NAM -->
        <a class="master-card" data-category="tactic vietnam"
           href="https://www.youtube.com/results?search_query=chiến+thuật+cờ+vua+cho+người+mới"
           target="_blank">
            <div class="master-icon">♘</div>

            <div class="master-content">
                <span class="master-level tactic">Chiến thuật - Tiếng Việt</span>
                <h2>Chiến Thuật Cờ Vua</h2>
                <p>
                    Học các đòn chiến thuật thường gặp như bắt đôi, ghim quân,
                    xiên quân và cách tìm nước thắng quân.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- CHIẾN THUẬT - QUỐC TẾ -->
        <a class="master-card" data-category="tactic international"
           href="https://www.youtube.com/results?search_query=chess+tactics+fork+pin+skewer"
           target="_blank">
            <div class="master-icon">♘</div>

            <div class="master-content">
                <span class="master-level tactic">Tactics - Quốc tế</span>
                <h2>Tactics Training</h2>
                <p>
                    Học fork, pin, skewer, discovered attack và các mẫu chiến thuật
                    quan trọng trong cờ vua.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- KHAI CUỘC - VIỆT NAM -->
        <a class="master-card" data-category="opening vietnam"
           href="https://www.youtube.com/results?search_query=khai+cuộc+cờ+vua+cho+người+mới"
           target="_blank">
            <div class="master-icon">♖</div>

            <div class="master-content">
                <span class="master-level opening">Khai cuộc - Tiếng Việt</span>
                <h2>Khai Cuộc Cờ Vua</h2>
                <p>
                    Học cách kiểm soát trung tâm, phát triển quân, nhập thành sớm
                    và chọn khai cuộc dễ chơi.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- KHAI CUỘC - QUỐC TẾ -->
        <a class="master-card" data-category="opening international"
           href="https://www.youtube.com/results?search_query=best+chess+openings+for+beginners"
           target="_blank">
            <div class="master-icon">♖</div>

            <div class="master-content">
                <span class="master-level opening">Opening - Quốc tế</span>
                <h2>Opening Guide</h2>
                <p>
                    Học các khai cuộc phổ biến cho người mới và cách xây dựng thế trận
                    ngay từ đầu ván.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- TÀN CUỘC - VIỆT NAM -->
        <a class="master-card" data-category="endgame vietnam"
           href="https://www.youtube.com/results?search_query=tàn+cuộc+cờ+vua+cơ+bản"
           target="_blank">
            <div class="master-icon">♔</div>

            <div class="master-content">
                <span class="master-level endgame">Tàn cuộc - Tiếng Việt</span>
                <h2>Tàn Cuộc Cơ Bản</h2>
                <p>
                    Học cách chiếu hết bằng Hậu, Xe, dùng Vua hỗ trợ Tốt
                    và kỹ thuật thắng ở cuối ván.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- TÀN CUỘC - QUỐC TẾ -->
        <a class="master-card" data-category="endgame international"
           href="https://www.youtube.com/results?search_query=chess+endgame+basics"
           target="_blank">
            <div class="master-icon">♔</div>

            <div class="master-content">
                <span class="master-level endgame">Endgame - Quốc tế</span>
                <h2>Endgame Mastery</h2>
                <p>
                    Học các kỹ thuật tàn cuộc quốc tế: king and pawn, rook endgame,
                    queen mate và nhiều mẫu quan trọng.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- CÂU ĐỐ - VIỆT NAM -->
        <a class="master-card" data-category="tactic vietnam"
           href="https://www.youtube.com/results?search_query=bài+tập+cờ+vua+câu+đố+cờ+vua"
           target="_blank">
            <div class="master-icon">♕</div>

            <div class="master-content">
                <span class="master-level tactic">Luyện tập - Tiếng Việt</span>
                <h2>Câu Đố Cờ Vua</h2>
                <p>
                    Luyện giải thế cờ bằng tiếng Việt để tăng khả năng nhìn đòn
                    và tìm nước đi mạnh.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- CÂU ĐỐ - QUỐC TẾ -->
        <a class="master-card" data-category="tactic international"
           href="https://www.youtube.com/results?search_query=chess+puzzle+training"
           target="_blank">
            <div class="master-icon">♕</div>

            <div class="master-content">
                <span class="master-level tactic">Puzzle - Quốc tế</span>
                <h2>Puzzle Training</h2>
                <p>
                    Luyện puzzle mỗi ngày để nhận ra chiến thuật nhanh hơn
                    và tránh sai lầm trong ván thật.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- TƯ DUY - VIỆT NAM -->
        <a class="master-card" data-category="basic vietnam"
           href="https://www.youtube.com/results?search_query=cách+tư+duy+khi+chơi+cờ+vua"
           target="_blank">
            <div class="master-icon">♟</div>

            <div class="master-content">
                <span class="master-level basic">Tư duy - Tiếng Việt</span>
                <h2>Cách Tư Duy Khi Chơi</h2>
                <p>
                    Học cách kiểm tra nguy hiểm, tìm nước ứng viên,
                    lập kế hoạch và tránh đi theo cảm tính.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

        <!-- TƯ DUY - QUỐC TẾ -->
        <a class="master-card" data-category="basic international"
           href="https://www.youtube.com/results?search_query=how+to+think+in+chess"
           target="_blank">
            <div class="master-icon">♟</div>

            <div class="master-content">
                <span class="master-level basic">Thinking - Quốc tế</span>
                <h2>Chess Thinking</h2>
                <p>
                    Học cách suy nghĩ như người chơi tốt: candidate moves,
                    threats, plans và calculation.
                </p>
                <strong>Xem bài học →</strong>
            </div>
        </a>

    </div>

    <div class="master-note">
        <h3>Gợi ý học hiệu quả</h3>
        <p>
            Người mới nên học theo thứ tự: luật cơ bản → chiến thuật → khai cuộc đơn giản
            → tàn cuộc → giải câu đố mỗi ngày. Có thể học nguồn tiếng Việt trước,
            sau đó xem thêm nguồn quốc tế để nâng trình.
        </p>

        <a asp-controller="Home" asp-action="Index" class="back-home-btn">
            ← Quay lại trang chủ
        </a>
    </div>
</section>

