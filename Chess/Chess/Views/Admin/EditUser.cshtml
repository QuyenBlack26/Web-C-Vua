@{
    ViewData["Title"] = "Sửa tài khoản";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <!-- FILE CSS ADMIN -->
    <link rel="stylesheet" href="~/css/Admin.css" />
    <link rel="stylesheet" href="~/css/KichThuoc.css" asp-append-version="true" />
</head>
<body>
    <!-- KHUNG TRANG ADMIN -->
    <div class="admin-page">

        <!-- SIDEBAR ADMIN -->
        <aside class="admin-sidebar">
            <h2>Admin</h2>

            <a asp-controller="Admin" asp-action="Index">Dashboard</a>
            <a asp-controller="Admin" asp-action="Users">Tài khoản</a>
            <a asp-controller="Admin" asp-action="Skins">Skin cờ</a>
            <a asp-controller="Home" asp-action="Index">Về trang chủ</a>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main class="admin-main">
            <h1>Sửa tài khoản: @ViewBag.TenDangNhap</h1>

            <!-- THÔNG BÁO LỖI -->
            @if (TempData["Error"] != null)
            {
                <div class="admin-alert error">@TempData["Error"]</div>
            }

            <!-- FORM SỬA TÀI KHOẢN -->
            <form asp-controller="Admin" asp-action="EditUser" method="post" class="admin-form">
                <input type="hidden" name="userId" value="@ViewBag.UserID" />

                <!-- TÊN ĐĂNG NHẬP -->
                <div class="admin-form-group">
                    <label>Tên đăng nhập</label>
                    <input type="text" value="@ViewBag.TenDangNhap" disabled />
                </div>

                <!-- THÔNG TIN CÁ NHÂN -->
                <div class="admin-form-group">
                    <label>Họ tên</label>
                    <input type="text" name="hoTen" value="@ViewBag.HoTen" />
                </div>

                <div class="admin-form-group">
                    <label>Gmail</label>
                    <input type="email" name="gmail" value="@ViewBag.Gmail" required />
                </div>

                <div class="admin-form-group">
                    <label>Số điện thoại</label>
                    <input type="text" name="soDienThoai" value="@ViewBag.SoDienThoai" placeholder="+84901234567" />
                </div>

                <div class="admin-form-group">
                    <label>Ngày sinh</label>
                    <input type="date" name="ngaySinh" value="@ViewBag.NgaySinh" />
                </div>

                <div class="admin-form-group">
                    <label>Giới tính</label>
                    <select name="gioiTinh">
                        <option value="">Chưa cập nhật</option>
                        <option value="NAM" selected="@(ViewBag.GioiTinh == "NAM")">Nam</option>
                        <option value="NU" selected="@(ViewBag.GioiTinh == "NU")">Nữ</option>
                        <option value="KHAC" selected="@(ViewBag.GioiTinh == "KHAC")">Khác</option>
                    </select>
                </div>

                <!-- TRẠNG THÁI TÀI KHOẢN -->
                <div class="admin-form-group">
                    <label>Trạng thái</label>
                    <select name="trangThai">
                        <option value="1" selected="@(ViewBag.TrangThai.ToString() == "True" || ViewBag.TrangThai.ToString() == "1")">Hoạt động</option>
                        <option value="0" selected="@(ViewBag.TrangThai.ToString() == "False" || ViewBag.TrangThai.ToString() == "0")">Khóa</option>
                    </select>
                </div>

                <!-- NÚT LƯU VÀ QUAY LẠI -->
                <div class="admin-form-actions">
                    <button type="submit" class="btn-admin-save">Lưu thay đổi</button>
                    <a asp-controller="Admin" asp-action="Users" class="btn-admin-back">Quay lại</a>
                </div>
            </form>
        </main>
    </div>
</body>
</html>