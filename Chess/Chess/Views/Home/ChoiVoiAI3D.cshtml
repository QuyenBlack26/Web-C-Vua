    <div class="footer-grid">

        <div class="footer-col">
            <h4>Sản Phẩm</h4>
            <ul>
                <li>
                    <a asp-controller="Play" asp-action="Online">
                        Chơi Trực Tiếp
                    </a>
                </li>

                <li>
                    <a asp-controller="Play" asp-action="Analysis">
                        Phân Tích
                    </a>
                </li>

                <li>
                    <a asp-controller="Play" asp-action="HocCoBan">
                        Học Tập
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Công Ty</h4>
            <ul>
                <li>
                    <a href="#" class="js-open-about-modal">
                        Về Chúng Tôi
                    </a>
                </li>

                <li>
                    <a href="#" class="js-open-blog-modal">
                        Blog
                    </a>
                </li>

                <li>
                    <a href="#" class="js-open-contact-modal">
                        Liên Hệ
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Pháp Lý</h4>
            <ul>
                <li>
                    <a href="#" class="js-open-terms-modal">
                        Điều Khoản
                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="Privacy">
                        Privacy
                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="Cookies">
                        Cookies
                    </a>
                </li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Mạng Xã Hội</h4>

            <div class="social-links">
                <a href="https://www.facebook.com/"
                   target="_blank"
                   rel="noopener noreferrer"
