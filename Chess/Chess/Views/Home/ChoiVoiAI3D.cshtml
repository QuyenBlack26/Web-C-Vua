@{
    Layout = null;
    ViewData["Title"] = "Chơi với AI 3D";
}

<link rel="stylesheet" href="~/css/TrangChinh.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/BanCo3D.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/KichThuoc.css" asp-append-version="true" />

@using Microsoft.AspNetCore.Http

<!-- THANH ĐIỀU HƯỚNG DÙNG CHUNG -->
<nav class="navbar">
    <div class="nav-container">

        <a asp-controller="Home"
           asp-action="Index"
           class="logo-modern nav-logo-link">
            <img src="/IMG/Logo/LogoTrangChinh.png" alt="Logo Quyến" class="main-logo-img">
            <span>Chess Online</span>
        </a>

        <ul class="nav-menu">
            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="home">
                    Trang Chủ
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="features">
                    Tính Năng
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="play">
                    Chơi Ngay
                </a>
            </li>

            <li><a asp-controller="Friend" asp-action="Index">Bạn bè</a></li>

            @if (Context.Session.GetString("TenDangNhap") != null)
            {
                var avatar = Context.Session.GetString("Avatar");
                var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "U";
                var hoTen = Context.Session.GetString("HoTen");
                var tenHienThi = string.IsNullOrWhiteSpace(hoTen) ? tenDangNhap : hoTen;
                var chuCai = tenHienThi.Length > 0 ? tenHienThi.Substring(0, 1).ToUpper() : "U";

                <li class="user-menu">
                    <details class="user-dropdown">
                        <summary class="avatar-btn">
                            <div class="avatar-circle">
                                @if (!string.IsNullOrWhiteSpace(avatar))
                                {
                                    <img src="@avatar"
                                         alt="Avatar"
                                         class="avatar-img" />
                                }
                                else
                                {
                                    @chuCai
                                }
                            </div>
                        </summary>

                        <div class="user-card">
                            <div class="user-card-header">
                                <div class="user-avatar-lg">
                                    @if (!string.IsNullOrWhiteSpace(avatar))
                                    {
                                        <img src="@avatar"
                                             alt="Avatar"
                                             class="user-avatar-img" />
                                    }
                                    else
                                    {
                                        @chuCai
                                    }
                                </div>

                                <div>
                                    <p class="user-card-name">@tenHienThi</p>
                                    <p class="user-card-role">Người chơi</p>
                                </div>
                            </div>

                            <a asp-controller="Home"
                               asp-action="ThongTinCaNhan"
                               class="btn-detail">
                                👤 Xem chi tiết
                            </a>

                            <a asp-controller="Home"
                               asp-action="DangXuat"
                               class="btn-logout">
                                🚪 Đăng xuất
                            </a>
                        </div>
                    </details>
                </li>
            }
            else
            {
                <li>
                    <a asp-controller="Home"
                       asp-action="DangNhap"
                       class="btn-nav-login">
                        Đăng Nhập
                    </a>
                </li>
            }
        </ul>

        <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

    </div>
</nav>

<!-- TRANG AI 3D TẠM THỜI -->
<section class="ai3d-page">
    <div class="ai3d-setup-card">
        <span class="ai3d-badge">AI 3D Mode</span>

        <h1>Chơi Cờ Vua Với AI 3D</h1>

        <p>
            Đây là bản nền đầu tiên cho chế độ cờ vua 3D. Bước sau mình sẽ thêm bàn cờ 3D,
            chọn cấp độ AI, chọn màu quân và kết nối lại AI hiện có.
        </p>

        <div class="ai3d-setup-grid">
            <div class="ai3d-field">
                <label>Cấp độ AI</label>
                <select id="ai3dLevelSelect">
                    <option value="easy">Dễ</option>
                    <option value="medium" selected>Trung bình</option>
                    <option value="hard">Khó</option>
                    <option value="boss">Boss</option>
                </select>
            </div>

            <div class="ai3d-field">
                <label>Màu quân</label>
                <select id="ai3dColorSelect">
                    <option value="white" selected>Trắng</option>
                    <option value="black">Đen</option>
                    <option value="random">Ngẫu nhiên</option>
                </select>
            </div>
        </div>

        <button type="button" id="ai3dStartBtn" class="ai3d-start-btn">
            Bắt đầu bản 3D
        </button>
    </div>

    <div class="ai3d-board-area">
        <div class="ai3d-board-top">
            <div>
                <h2>Bàn cờ 3D</h2>
                <p id="ai3dStatusText">
                    Hãy chọn cấp độ và màu quân, sau đó bấm bắt đầu.
                </p>
            </div>

            <div class="ai3d-status-pill" id="ai3dSideText">
                Chưa bắt đầu
            </div>

            <div class="ai3d-actions">
                <button type="button" id="ai3dNewGameBtn">
                    Ván mới
                </button>

                <button type="button" id="ai3dResignBtn" class="ai3d-resign-btn">
                    Đầu hàng
                </button>
            </div>

        </div>

        <div id="ai3dSceneContainer" class="ai3d-scene-container">
            <div class="ai3d-scene-placeholder">
                <span>♞</span>
                <strong>Chưa khởi tạo bàn cờ 3D</strong>
                <p>Bấm “Bắt đầu bản 3D” để dựng bàn cờ.</p>
            </div>
        </div>

        <div class="ai3d-bottom-panel">
            <div class="ai3d-history-card">
                <h3>Lịch sử nước đi</h3>
                <div id="ai3dMoveHistory" class="ai3d-move-history">
                    Chưa có nước đi.
                </div>
            </div>
        </div>

    </div>
</section>

<div class="game-result-overlay" id="gameResultOverlay">
    <div class="game-result-box">
        <div class="game-result-icon" id="gameResultIcon">
            🏆
        </div>

        <h2 id="gameResultTitle">
            Trận đấu kết thúc
        </h2>

        <p id="gameResultMessage">
            Kết quả đã được ghi nhận.
        </p>

        <div class="game-result-score" id="gameResultScore">
            +15 điểm
        </div>

        <button type="button" class="game-result-btn" id="gameResultCloseBtn">
            Đóng
        </button>
    </div>
</div>

<!-- MODAL PHONG CẤP AI 3D -->
<div class="ai3d-promotion-overlay" id="ai3dPromotionOverlay">
    <div class="ai3d-promotion-box">
        <h2>Chọn quân phong cấp</h2>
        <p>Chọn quân bạn muốn phong cấp cho Tốt.</p>

        <div class="ai3d-promotion-grid">
            <button type="button" class="ai3d-promotion-choice" data-piece="q">
                <span>♕</span>
                <strong>Hậu</strong>
            </button>

            <button type="button" class="ai3d-promotion-choice" data-piece="r">
                <span>♖</span>
                <strong>Xe</strong>
            </button>

            <button type="button" class="ai3d-promotion-choice" data-piece="b">
                <span>♗</span>
                <strong>Tượng</strong>
            </button>

            <button type="button" class="ai3d-promotion-choice" data-piece="n">
                <span>♘</span>
                <strong>Mã</strong>
            </button>
        </div>
    </div>
</div>
<!-- FOOTER DÙNG CHUNG CHO CÁC TRANG -->
