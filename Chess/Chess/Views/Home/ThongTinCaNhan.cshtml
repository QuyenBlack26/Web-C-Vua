@{
    ViewData["Title"] = "Thông tin cá nhân";

}
@{
    Layout = null;
}

<!-- FILE CSS TRANG CHÍNH VÀ THÔNG TIN CÁ NHÂN -->
<link rel="stylesheet" href="~/css/ThongTinCaNhan.css" />


<link rel="stylesheet" href="~/css/BanCo.css" />
<link rel="stylesheet" href="~/css/TrangChinh.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/KichThuoc.css" asp-append-version="true" />


@using Microsoft.AspNetCore.Http

<!-- THANH ĐIỀU HƯỚNG DÙNG CHUNG -->
<nav class="navbar">
    <div class="nav-container">

        <!-- LOGO WEBSITE -->
        <a asp-controller="Home"
           asp-action="Index"
           class="logo-modern nav-logo-link">
            <img src="/IMG/Logo/LogoTrangChinh.png" alt="Logo Quyến" class="main-logo-img">
            <span>Chess Online</span>
        </a>

        <!-- MENU TRANG CHÍNH -->
        <ul class="nav-menu">
            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="home">
                    Trang Chủ
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="features">
                    Tính Năng
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="play">
                    Chơi Ngay
                </a>
            </li>

            <li><a asp-controller="Friend" asp-action="Index">Bạn bè</a></li>

            @if (Context.Session.GetString("TenDangNhap") != null)
            {
                var avatar = Context.Session.GetString("Avatar");
                var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "U";
                var hoTen = Context.Session.GetString("HoTen");
                var tenHienThi = string.IsNullOrWhiteSpace(hoTen) ? tenDangNhap : hoTen;
                var chuCai = tenHienThi.Length > 0 ? tenHienThi.Substring(0, 1).ToUpper() : "U";

                <li class="user-menu">
                    <details class="user-dropdown">

                        <!-- AVATAR USER -->
                        <summary class="avatar-btn">
                            <div class="avatar-circle">
                                @if (!string.IsNullOrWhiteSpace(avatar))
                                {
                                    <img src="@avatar"
                                         alt="Avatar"
                                         class="avatar-img" />
                                }
                                else
                                {
                                    @chuCai
                                }
                            </div>
                        </summary>

                        <!-- DROPDOWN THÔNG TIN USER -->
                        <div class="user-card">
                            <div class="user-card-header">
                                <div class="user-avatar-lg">
                                    @if (!string.IsNullOrWhiteSpace(avatar))
                                    {
                                        <img src="@avatar"
                                             alt="Avatar"
                                             class="user-avatar-img" />
                                    }
                                    else
                                    {
                                        @chuCai
                                    }
                                </div>

                                <div>
                                    <p class="user-card-name">@tenHienThi</p>
                                    <p class="user-card-role">Người chơi</p>
                                </div>
                            </div>

                            <a asp-controller="Home"
                               asp-action="ThongTinCaNhan"
                               class="btn-detail">
                                👤 Xem chi tiết
                            </a>

                            <a asp-controller="Home"
                               asp-action="DangXuat"
                               class="btn-logout">
                                🚪 Đăng xuất
                            </a>
                        </div>

                    </details>
                </li>
            }
            else
            {
                <li>
                    <a asp-controller="Home"
                       asp-action="DangNhap"
                       class="btn-nav-login">
                        Đăng Nhập
                    </a>
                </li>
            }
        </ul>

        <!-- NÚT MENU MOBILE -->
        <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

    </div>
</nav>

<!-- TRANG THÔNG TIN CÁ NHÂN -->
<div class="profile-page">

    <!-- THẺ THÔNG TIN CÁ NHÂN -->
    <div class="profile-card">

        <!-- PHẦN ĐẦU HỒ SƠ -->
        <div class="profile-header">
            <div class="profile-avatar-img">
                <img src="@ViewBag.Avatar" alt="Avatar" />
            </div>

            <div>
                <h1>Thông tin cá nhân</h1>
                <p>Tài khoản: <strong>@ViewBag.TenDangNhap</strong></p>
            </div>
        </div>

        <!-- THÔNG BÁO LỖI -->
        @if (ViewBag.Error != null)
        {
            <div class="alert error">@ViewBag.Error</div>
        }

        <!-- THÔNG BÁO THÀNH CÔNG -->
        @if (ViewBag.Success != null)
        {
            <div class="alert success">@ViewBag.Success</div>
        }

        <!-- FORM CẬP NHẬT THÔNG TIN CÁ NHÂN -->
        <form asp-controller="Home"
              asp-action="ThongTinCaNhan"
              method="post"
              enctype="multipart/form-data"
              class="profile-form">

            <!-- Ô NHẬP HỌ TÊN -->
            <div class="form-group">
                <label>Họ tên</label>
                <input type="text" name="hoTen" value="@ViewBag.HoTen" placeholder="Nhập họ tên của bạn" />
            </div>

            <!-- Ô NHẬP SỐ ĐIỆN THOẠI -->
            <div class="form-group">
                <label>Số điện thoại</label>

                <div class="phone-row">
                    <select id="maQuocGia">
                        <option value="+84" selected>🇻🇳 Việt Nam (+84)</option>
                        <option value="+1">🇺🇸 Mỹ / Canada (+1)</option>
                        <option value="+81">🇯🇵 Nhật Bản (+81)</option>
                        <option value="+82">🇰🇷 Hàn Quốc (+82)</option>
                        <option value="+86">🇨🇳 Trung Quốc (+86)</option>
                        <option value="+44">🇬🇧 Anh (+44)</option>
                        <option value="+33">🇫🇷 Pháp (+33)</option>
                        <option value="+49">🇩🇪 Đức (+49)</option>
                        <option value="+61">🇦🇺 Úc (+61)</option>
                        <option value="+65">🇸🇬 Singapore (+65)</option>
                    </select>

                    <input type="text"
                           id="soDienThoaiNhap"
                           placeholder="Ví dụ: 0901234567"
                           autocomplete="tel" />
                </div>

                <input type="hidden" name="soDienThoai" id="soDienThoai" value="@ViewBag.SoDienThoai" />
                <small>Hệ thống sẽ tự lưu dạng quốc tế, ví dụ: +84901234567.</small>
            </div>

            <!-- Ô NHẬP GMAIL -->
            <div class="form-group">
                <label>Gmail</label>
                <input type="email" name="gmail" value="@ViewBag.Gmail" placeholder="Nhập Gmail" required />
            </div>

            <!-- Ô NHẬP NGÀY SINH -->
            <div class="form-group">
                <label>Ngày sinh</label>
                <input type="date" name="ngaySinh" value="@ViewBag.NgaySinh" />
            </div>

            <!-- Ô CHỌN GIỚI TÍNH -->
            <div class="form-group">
                <label>Giới tính</label>
                <select name="gioiTinh">
                    <option value="">Chưa cập nhật</option>
                    <option value="NAM" selected="@(ViewBag.GioiTinh == "NAM")">Nam</option>
                    <option value="NU" selected="@(ViewBag.GioiTinh == "NU")">Nữ</option>
                    <option value="KHAC" selected="@(ViewBag.GioiTinh == "KHAC")">Khác</option>
                </select>
            </div>

            <!-- Ô CHỌN ẢNH ĐẠI DIỆN -->
            <div class="form-group">
                <label>Ảnh đại diện</label>
                <input type="file" name="avatarFile" accept="image/*" />
                <small>Chọn ảnh từ thiết bị. Hỗ trợ JPG, PNG, GIF, WEBP. Tối đa 2MB.</small>
            </div>

            <!-- NÚT LƯU VÀ QUAY LẠI -->
            <div class="profile-actions">
                <button type="submit" class="btn-save">Lưu thông tin</button>
                <a asp-controller="Home" asp-action="Index" class="btn-back">Quay về trang chủ</a>
            </div>
        </form>
    </div>
</div>

