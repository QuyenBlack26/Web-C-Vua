<!-- FILE JAVASCRIPT FOOTER + MODAL -->
<script src="~/js/TrangChinh.js" asp-append-version="true"></script>

<script>
    /* LẤY CÁC PHẦN TỬ XỬ LÝ SỐ ĐIỆN THOẠI */
    const hiddenPhoneInput = document.getElementById("soDienThoai");
    const phoneInput = document.getElementById("soDienThoaiNhap");
    const countryCodeSelect = document.getElementById("maQuocGia");
    const profileForm = document.querySelector(".profile-form");

    /* HIỂN THỊ LẠI SỐ ĐIỆN THOẠI CŨ */
    function loadOldPhone() {
        const oldPhone = hiddenPhoneInput.value;

        if (!oldPhone || !oldPhone.startsWith("+")) {
            return;
        }

        const codes = Array.from(countryCodeSelect.options)
            .map(option => option.value)
            .sort((a, b) => b.length - a.length);

        const matchedCode = codes.find(code => oldPhone.startsWith(code));

        if (matchedCode) {
            countryCodeSelect.value = matchedCode;
            phoneInput.value = oldPhone.substring(matchedCode.length);
        }
    }

    /* TẠO SỐ ĐIỆN THOẠI DẠNG QUỐC TẾ */
    function buildInternationalPhone() {
        let countryCode = countryCodeSelect.value;
        let localNumber = phoneInput.value.trim();

        localNumber = localNumber.replace(/[\s\-\.]/g, "");

        if (localNumber.startsWith("+")) {
            hiddenPhoneInput.value = localNumber;
            return;
        }

        while (localNumber.startsWith("0")) {
            localNumber = localNumber.substring(1);
        }

        if (localNumber === "") {
            hiddenPhoneInput.value = "";
            return;
        }

        hiddenPhoneInput.value = countryCode + localNumber;
    }

    /* CẬP NHẬT SỐ ĐIỆN THOẠI KHI NGƯỜI DÙNG NHẬP */
    phoneInput.addEventListener("input", buildInternationalPhone);
    countryCodeSelect.addEventListener("change", buildInternationalPhone);

    /* CẬP NHẬT SỐ ĐIỆN THOẠI TRƯỚC KHI GỬI FORM */
    if (profileForm) {
        profileForm.addEventListener("submit", function () {
            buildInternationalPhone();
        });
    }

    /* CHẠY HIỂN THỊ SỐ ĐIỆN THOẠI CŨ */
    loadOldPhone();
</script>